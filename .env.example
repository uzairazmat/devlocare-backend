# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- App ---
APP_NAME=DevloCare API
APP_VERSION=1.0.0
ENVIRONMENT=development

# --- Database ---
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./devlocare.db
# PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Auth / JWT ---
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_strong_random_secret_here
JWT_ALGORITHM=HS256
# 8 hours. Pair with a frontend idle timeout (~30 min) for production.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Misc ---
DEFAULT_LANGUAGE=English

# --- Rate limiting (slowapi) ---
# Set RATE_LIMIT_ENABLED=false in tests to disable. Limits use slowapi
# string syntax: "<count>/<period>" where period is second/minute/hour/day.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_PREDICT=30/minute

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
# Default covers Vite dev on localhost and 127.0.0.1. For LAN testing
# add http://<your-lan-ip>:5173 to this list. Use "*" only in dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Super Admin Bootstrap ---
# Created automatically on first startup ONLY. There is no API endpoint to
# create a super admin. Leaving these blank skips bootstrap (useful for
# read-only / migration runs).
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_me_in_production
SUPER_ADMIN_EMAIL=superadmin@example.com
